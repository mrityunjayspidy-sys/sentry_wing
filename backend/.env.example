# SentryWing Wildlife Intelligence & Target Tracking Configuration

# Server settings
HOST=0.0.0.0
PORT=8000

# Live Feed Publishing to External Service (Admin/Vet Live Feed Viewer)
# Set to the external WebSocket endpoint of the main dashboard backend
# e.g., ws://localhost:8000/ws/live-feed or ws://remote-dashboard.local:8000/ws/live-feed
PUBLISH_TARGET_URL=
PUBLISH_FEED_ENABLED=true

# YOLO Detection settings
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
INPUT_IMAGE_SIZE=640

# Tracking settings
LOCK_LOST_THRESHOLD=10
MATCH_DISTANCE_THRESHOLD=0.55
CENTER_DEADBAND=0.08
VELOCITY_HISTORY_FRAMES=5
VELOCITY_DAMPING=0.88
