# =============================================================================
# SentryWing ESP32-CAM MJPEG to WebSocket Bridge Configuration
# =============================================================================

# ESP32-CAM MJPEG HTTP Stream URL
# e.g. http://192.168.4.1/stream (ESP32 AP mode) or http://192.168.1.100:81/stream
ESP32_STREAM_URL=http://192.168.4.1/stream

# Dashboard Field Source WebSocket Endpoint
DASHBOARD_WS_URL=ws://127.0.0.1:8000/ws/live-feed

# Camera Unit Identifier
ESP32_SOURCE_ID=esp32-cam-1

# Fixed Geolocation (since ESP32 modules do not have onboard GPS)
ESP32_LAT=29.5312
ESP32_LNG=78.7744
ESP32_LOCATION_NAME=Corbett Sector 4 Outpost (ESP32 Unit 1)

# Target transmission frame rate
ESP32_TARGET_FPS=12

# Optional Neural Detection on Bridge: true to run YOLO + TargetTracker, false for raw feed
ENABLE_DETECTION=true
CONFIDENCE_THRESHOLD=0.25
