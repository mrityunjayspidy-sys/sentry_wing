# SentryWing Supabase Cloud Configuration
# Replace these with your Supabase Project URL and Anon/Public Key from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SentryWing Backend Server Link (Optional for Vercel cloud deployments)
# Leave blank when running locally via Vite dev proxy.
# If deployed on Vercel and connecting to a remote/tunneled backend, set these:
# VITE_API_URL=https://your-backend-tunnel.loca.lt
# VITE_WS_URL=wss://your-backend-tunnel.loca.lt
